# ============================================================
# STANDALONE DEPLOYMENT - Environment File
# Copy to .env on the bot machine and fill in ALL values
# ============================================================

# ============================================================
# REQUIRED - Core Trading (Kraken Canada)
# ============================================================
KRAKEN_API_KEY=your_kraken_public_key_here
KRAKEN_API_SECRET=your_kraken_private_key_here

# ============================================================
# REQUIRED - AI Orchestrator (OpenRouter)
# ============================================================
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# ============================================================
# REQUIRED - Freqtrade Auth & Encryption
# Generate with: openssl rand -base64 32
# ============================================================
FREQTRADE_API_PASSWORD=your_base64_password_here
FREQTRADE_ENCRYPT_KEY=your_base64_encrypt_key_here

# ============================================================
# REQUIRED - Backup Encryption (Age PUBLIC key only)
# Generate with: age-keygen -o age_keys.txt
# Use the PUBLIC key (starts with age1...)
# ============================================================
BACKUP_ENCRYPT_KEY=age1your_public_key_here

# ============================================================
# OPTIONAL - Discord Notifications
# Create webhook in Discord: Server Settings → Integrations → Webhooks
# ============================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# ============================================================
# OPTIONAL - Nextcloud Backup (WebDAV)
# Create App Password in Nextcloud: Settings → Security → App Passwords
# WebDAV URL format: https://domain/remote.php/dav/files/username/backups
# ============================================================
NEXTCLOUD_URL=https://your-domain.com/remote.php/dav/files/username/backups
NEXTCLOUD_USER=your_username
NEXTCLOUD_PASS=your_app_password

# ============================================================
# DEPLOYMENT CONFIG
# ============================================================
GITHUB_REPOSITORY_OWNER=yourgithubusername
TZ=America/Toronto

# ============================================================
# OPTIONAL - Custom Image Tags (for pinning versions)
# ============================================================
# AI_ORCHESTRATOR_IMAGE=ghcr.io/youruser/kraken-ai-orchestrator:v1.0.0
# BACKUP_IMAGE=ghcr.io/youruser/kraken-backup:v1.0.0
