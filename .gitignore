# Secrets - NEVER COMMIT
#
# There is no secrets/ directory in this repository and there should not be one:
# credentials are Docker Swarm secrets created in Portainer. The entry is kept as
# a backstop, so that a directory by that name created by habit cannot be
# committed. See "Where credentials live" in README.md.
secrets/
*.key
*.pem
*.crt

# Environment
.env
.env.local
.env.*.local

# Docker
docker-compose.override.yml

# Logs
*.log
logs/
**/logs/

# Data
data/
user_data/data/
user_data/logs/

# Backup temp
/tmp/backup/
backup_temp/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Generated strategies are written to the SHARED strategies volume at
# /app/strategies (mounted from the kraken-strategies-shared volume), not into
# this repository - so there is nothing here to ignore. The old
# config/strategies/generated/ entry was removed because it named a path that
# has never existed, which makes a reader think the directory is in use.

# Audit logs
**/audit/
