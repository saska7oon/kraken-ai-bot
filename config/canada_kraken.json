// =============================================================================
// Kraken Canada - country-specific overrides
// =============================================================================
// Loaded AFTER base.json, so anything here replaces the base value.
// Contains NO secrets.
//
// KRAKEN CANADA CONSTRAINTS (2026)
// Kraken Canada operates as a Registered Restricted Dealer (OSC lead, CSA).
// Spot trading only: no margin, no futures, no derivatives, and no short
// selling. Funding is Interac e-Transfer or wire. The pairs below are the CAD
// markets that actually exist on the Canadian venue.
//
// WHY JSON AND NOT YAML:
// Freqtrade parses every config file with rapidjson regardless of extension,
// so comments must be // or /* */, never #.
// =============================================================================
{
    "exchange": {
        "name": "kraken",

        "ccxt_async_config": {
            "enableRateLimit": true,
            // Kraken is strict about request rates. ~3.5s between calls keeps
            // the bot well clear of the rate limiter.
            "rateLimit": 3500
        },

        // The CAD spot markets in scope.
        //
        // These four are every liquid crypto/CAD market Kraken actually offers.
        // Kraken's CAD book is small - 11 markets total, of which the rest are
        // fiat (EUR, USD) and stablecoins this config excludes on purpose.
        //
        // ADA/CAD was here briefly and is NOT a Kraken market. Kraken lists ADA
        // against AUD, EUR, GBP, USD, USDC, USDT, XBT and ETH - not CAD. The
        // mistake came from reading Kraken's /convert/ada/cad page, which shows
        // a converted price and is not an order book. Freqtrade checks the real
        // market list and silently dropped the pair on every startup, which is
        // how it was caught. tools/check_pairs_against_kraken.py now verifies
        // this list against the exchange, so the same mistake fails loudly.
        //
        // Note what a whitelist entry does NOT do: it does not give the bot
        // access to coins you already hold. Freqtrade trades only positions it
        // opened itself, and an exit sells trade.amount - the amount it bought,
        // not the wallet balance. Its one reconciliation against the wallet
        // (freqtradebot.py, the `total > trade.amount * 0.98` branch) can only
        // revise an amount DOWNWARD, so a large pre-existing holding is never
        // swept into a trade and never sold by the bot.
        "pair_whitelist": [
            "BTC/CAD",
            "ETH/CAD",
            "SOL/CAD",
            "XRP/CAD"
        ],

        // Excluded deliberately.
        //   USDC/USDT - stablecoin pairs; the bot would be trading CAD against
        //               something designed not to move, paying fees both ways.
        //   PEPE      - a meme token with no fundamental value.
        //   .*/BULL, .*/BEAR, .*/HALF, .*/HEDGE - leveraged and inverse
        //               products. Kraken Canada does not offer them, and any
        //               pair matching these would simply fail to trade.
        "pair_blacklist": [
            "USDC/CAD",
            "USDT/CAD",
            "PEPE/CAD",
            ".*/BULL",
            ".*/BEAR",
            ".*/HALF",
            ".*/HEDGE"
        ]
    },

    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],

    // -------------------------------------------------------------------------
    // ACCOUNT
    // -------------------------------------------------------------------------
    "stake_currency": "CAD",
    "fiat_display_currency": "CAD",

    // =========================================================================
    //  THE DRY-RUN / LIVE SWITCH
    // =========================================================================
    // These two lines must always change TOGETHER. They live here, side by
    // side, because this file is merged last and therefore wins - and because
    // changing one without the other is silent and expensive.
    //
    // Freqtrade picks its database from `dry_run`, but only when `db_url` is
    // unset or exactly its own default. Ours is an absolute path, so that
    // automatic choice never happens and whichever file is named here is used
    // in BOTH modes:
    //
    //   if dry_run:
    //       if db_url in [None, "sqlite:///tradesv3.sqlite"]:
    //           db_url = "sqlite:///tradesv3.dryrun.sqlite"
    //
    // One shared file would mean two things:
    //   1. Profit and win-rate blend simulated trades with real ones, so the
    //      number you would use to judge the bot becomes meaningless exactly
    //      when it starts to matter.
    //   2. Open dry-run trades are still in the database when you go live, so
    //      the bot tries to manage positions that do not exist on Kraken.
    //
    // TO GO LIVE, change both of these, and close every open position first:
    //     "dry_run": false,
    //     "db_url": "sqlite:////freqtrade/user_data/data/tradesv3.sqlite",
    //
    // TO GO BACK to simulation, reverse both lines. Nothing is deleted: your
    // live history stays in tradesv3.sqlite and your simulation history stays
    // in tradesv3.dryrun.sqlite, so each mode resumes where it left off.
    //
    // tools/preflight_config.py refuses to start if the two disagree.
    "dry_run": true,
    "dry_run_wallet": 1000,
    "db_url": "sqlite:////freqtrade/user_data/data/tradesv3.dryrun.sqlite",

    // -------------------------------------------------------------------------
    // RISK (moderate profile, sized for DAILY candles)
    // -------------------------------------------------------------------------
    // These four values are duplicated in config/base.json on purpose - both
    // files are loaded and this one is applied second. They must stay identical
    // or the bot's behaviour depends on file order. The full reasoning lives in
    // base.json; the short version is that each was a 5-minute value:
    //
    //   stoploss -0.08 -> -0.12   measured daily ATR is 2.7%-5.7%, so -0.08 was
    //                             only 1.4xATR on XRP - inside the daily noise.
    //                             -0.12 clears 2xATR on all four pairs.
    //   trail    0.02 -> 0.08     a 2% trail is under one ordinary day's range.
    //   offset   0.03 -> 0.10     start trailing only after a real trend move.
    //   roi      ladder -> {"0": 1.0}
    //                             the old keys were MINUTES and a daily candle is
    //                             1440 of them, so after 120 minutes the target
    //                             was 0% and every winner was sold at once.
    //                             Disabled so trends are not capped.
    "max_open_trades": 3,
    "stake_amount": "unlimited",

    // Use at most 90% of the wallet, holding 10% back.
    "tradable_balance_ratio": 0.90,
    "amount_reserve_percent": 0.05,

    "stoploss": -0.12,

    // OFF. See config/base.json for the measurement: with the old
    // trailing_only_offset_is_reached=false the stop trailed 12% below every
    // candle's high from trade open, which lost money in 8 of 8 parameter sets.
    // The Donchian 10-day-low exit is already a trailing stop.
    "trailing_stop": false,
    "trailing_stop_positive": 0.08,
    "trailing_stop_positive_offset": 0.10,
    "trailing_only_offset_is_reached": true,

    "minimal_roi": {
        "0": 1.0
    },

    // -------------------------------------------------------------------------
    // STRATEGY (must match config/strategies/moderate_multi.py)
    // -------------------------------------------------------------------------
    "strategy": "ModerateMultiPairStrategy",

    // -------------------------------------------------------------------------
    // API SERVER / WEBSERVER
    // -------------------------------------------------------------------------
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "info",
        "enable_openapi": true,
        "CORS_origins": [
            "http://localhost:8082",
            "http://127.0.0.1:8082"
        ]
    },

    "webserver": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8081,
        "verbosity": "info"
    },

    // -------------------------------------------------------------------------
    // LOGGING
    // -------------------------------------------------------------------------
    "logging": {
        "logfile": "/freqtrade/user_data/logs/freqtrade.log",
        "loglevel": "INFO",
        "logfile_level": "DEBUG",
        "syslog": false,
        "logrotate": true,
        "logrotate_max_bytes": 10485760,
        "logrotate_backup_count": 10
    }
}
