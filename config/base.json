// =============================================================================
// Freqtrade Base Configuration
// =============================================================================
// This file contains NO secrets. Credentials are injected at container start
// by /etc/freqtrade-entrypoint.sh, which reads the Docker Swarm secrets and
// generates an ephemeral private config in tmpfs (/dev/shm).
//
// DO NOT add api keys, passwords or webhook URLs to this file.
//
// WHY JSON AND NOT YAML:
// Freqtrade parses every config file with rapidjson - see
// freqtrade/configuration/load_config.py. There is no YAML support at all, and
// the file extension is ignored, so a .yaml file is still parsed as JSON and
// fails immediately. Comments must therefore be // or /* */, never #.
//
// The parser runs with comments and trailing commas enabled, so // comments
// like these are safe and are officially supported.
// =============================================================================
{
    // -------------------------------------------------------------------------
    // EXCHANGE
    // -------------------------------------------------------------------------
    "exchange": {
        "name": "kraken",

        // Credentials come from the generated private config, never from here.
        // "key" and "secret" are provided at runtime by the entrypoint.

        "ccxt_config": {
            "enableRateLimit": true
        },

        "ccxt_async_config": {
            "enableRateLimit": true,
            "rateLimit": 3500
        },

        "skip_pair_validation": false,

        // StaticPairList reads the whitelist from here. Overridden in
        // canada_kraken.json with the CAD pairs.
        "pair_whitelist": [
            "BTC/CAD"
        ],

        // Pair blacklist. Entries are regexes, not globs.
        "pair_blacklist": [
            ".*/BULL",
            ".*/BEAR",
            ".*/HALF",
            ".*/HEDGE",
            "PEPE/CAD"
        ]
    },

    // -------------------------------------------------------------------------
    // PAIRLIST HANDLER
    // -------------------------------------------------------------------------
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],

    // -------------------------------------------------------------------------
    // STAKE / TRADING
    // -------------------------------------------------------------------------
    "stake_currency": "CAD",
    "fiat_display_currency": "CAD",

    // ALWAYS start with dry_run: true. Switching this to false places real
    // orders with real money, and it cannot be done through the AI interface
    // or the orchestrator API - only by editing a config and redeploying.
    //
    // This value is a DEFAULT ONLY. config/canada_kraken.json is merged last
    // and overrides it, so editing the line below has no effect - that is where
    // the switch actually lives, together with the matching db_url.
    "dry_run": true,
    "dry_run_wallet": 1000,

    "max_open_trades": 3,
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.90,
    "amount_reserve_percent": 0.05,

    "amend_last_stake_amount": true,
    "last_stake_amount_min_ratio": 0.5,

    // Position adjustment lets a strategy add to an existing trade. The
    // strategy does not implement it, and it MUST be present here: freqtrade
    // reads it with a direct subscript in rpc_manager.startup_messages:
    //
    //     pos_adjust_enabled = "On" if config["position_adjustment_enable"] else "Off"
    //
    // There is no schema default, so leaving it out is a KeyError during
    // startup - after the exchange has already been constructed and validated.
    "position_adjustment_enable": false,

    // -------------------------------------------------------------------------
    // RISK MANAGEMENT (moderate profile)
    // -------------------------------------------------------------------------
    // stoploss is how much a single trade may lose before it is closed
    // automatically. -0.08 means 8%.
    "stoploss": -0.08,

    "trailing_stop": true,
    "trailing_stop_positive": 0.02,
    "trailing_stop_positive_offset": 0.03,
    "trailing_only_offset_is_reached": false,

    // Profit targets: take 4% immediately, then relax over time so a trade is
    // never held open forever waiting for a target that has passed.
    "minimal_roi": {
        "0": 0.04,
        "30": 0.02,
        "60": 0.01,
        "120": 0
    },

    // -------------------------------------------------------------------------
    // FEES
    // -------------------------------------------------------------------------
    // 0.80% is Kraken's Tier 1 taker rate, applied to each side of a trade, so a
    // round trip costs about 1.60%.
    //
    // THIS NUMBER WAS NOT SET BEFORE, AND THE DEFAULT WAS WRONG.
    //
    // With no `fee` here, Freqtrade asks ccxt for the exchange's rate:
    //
    //     freqtrade/exchange/exchange.py, get_fee():
    //         return self._api.calculate_fee(...)["rate"]
    //
    // ccxt reads it from the market's `taker` field, which Kraken's API returns
    // EMPTY - verified live, `"fees": []` and `"fees_maker": []` on XBTCAD. ccxt
    // therefore falls back to a hardcoded default of 0.0026 taker / 0.0016 maker,
    // which is roughly a third of what Kraken actually charges a Tier 1 account.
    //
    // Kraken's published schedule (kraken.com/ca/features/fee-schedule):
    //     Tier 1, $0+ 30-day volume:  maker 0.40%   taker 0.80%
    //     Tier 2, $2.5K+:             maker 0.30%   taker 0.60%
    // CAD pairs follow the same schedule as every other pair.
    //
    // So every simulated result before this change assumed 0.52% round trip
    // instead of 1.60%, and was therefore about three times too optimistic. On a
    // 5-minute timeframe that difference is not a detail: the average BTC/CAD 5m
    // candle moves 0.076% in total, so 1.60% of fees is roughly 21 candles' worth
    // of movement to break even.
    //
    // Taker rather than maker - but NOT for the reason first written here.
    //
    // CORRECTION. This block previously claimed the bot's limit orders "sit at
    // the touch of the book, where they often fill immediately and are charged as
    // taker". That is wrong, and the source says so. From
    // freqtrade/exchange/exchange.py::_get_price_side:
    //
    //     ("entry", "long", "same"): "bid",     <- our config
    //     ("exit",  "long", "same"): "ask",     <- our config
    //
    // price_side "same" on a long entry prices at the BID, which is a resting buy
    // order - a maker order. Same on the exit side at the ask. So the bot is
    // already configured to pay the maker rate on both legs, and the real round
    // trip on the normal path is 0.80%, not 1.60%.
    //
    // The taker rate is still what is charged here, deliberately, for two reasons
    // that the mapping does not capture:
    //
    //   1. Stoploss and emergency_exit are market orders by freqtrade's default
    //      (see the explicit order_types block below). Those exits cross the
    //      spread and pay 0.80%. A stoploss exit therefore costs 0.40% + 0.80%.
    //   2. A resting order only fills when the market comes to it, which is
    //      adverse selection: the bid gets hit while price is falling. The fill
    //      is real, the price is worse.
    //
    // So the true figure sits between 0.40% and 0.80% per side depending on how
    // often stops trigger, and it is not knowable in advance. Charging the worst
    // case keeps the simulation on the pessimistic side - a strategy that looks
    // viable at 0.008 is genuinely robust, whereas one tuned to pass at 0.004
    // would be tuned to a number the config cannot actually guarantee.
    //
    // Only affects simulation. Freqtrade honours this key ONLY in dry run:
    //
    //     if self._config["dry_run"] and self._config.get("fee", None) is not None:
    //         return self._config["fee"]
    //
    // In live trading the real fee comes back on the order itself, which is more
    // accurate than any number set here.
    // -------------------------------------------------------------------------
    "fee": 0.008,

    // -------------------------------------------------------------------------
    // PRICING
    // -------------------------------------------------------------------------
    // entry_pricing and exit_pricing are REQUIRED keys. They are listed in
    // SCHEMA_TRADE_REQUIRED in freqtrade/config_schema/config_schema.py, and
    // freqtrade reads them with direct subscripting rather than .get():
    //
    //     self.validate_pricing(config["exit_pricing"])
    //     self.validate_pricing(config["entry_pricing"])
    //
    // so omitting them is not a warning, it is a KeyError that kills startup.
    // Freqtrade can migrate them from the old bid_strategy / ask_strategy
    // blocks, but only when one of those legacy blocks exists. With neither
    // present, nothing creates them.
    //
    // price_side selects which side of the spread is used to price an order:
    //   "ask" / "bid"  always that side
    //   "same"         the side the order is on
    //   "other"        the opposite side
    // "same" is freqtrade's documented default and what its own example config
    // uses, so it is the best-tested path. The schema requires price_side in
    // both blocks.
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0
    },

    // -------------------------------------------------------------------------
    // ORDER TYPES
    // -------------------------------------------------------------------------
    // Written out explicitly rather than left to freqtrade's defaults, because
    // these decide the fee and the fee is what decides whether anything here can
    // work. Left implicit, they are invisible - which is how the bot ended up
    // trading on a 5m timeframe with a fee nobody had checked.
    //
    // entry / exit are "limit". Combined with price_side "same" above, that is a
    // resting order on both legs: buy at the bid, sell at the ask, and the maker
    // rate of 0.40% rather than the taker rate of 0.80%.
    //
    // stoploss and emergency_exit are "market" on purpose. A stoploss exists to
    // get you out, and a limit order at a price that is running away does not
    // fill - you would keep the position and the loss. Paying the taker rate to
    // actually be out is the correct trade. This is also why the `fee` above is
    // charged at the taker rate.
    //
    // force_entry / force_exit are the manual buttons in the UI. Market, because
    // when the operator clicks "sell now" they mean now.
    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false
    },

    // -------------------------------------------------------------------------
    // UNFILLED ORDER TIMEOUT
    // -------------------------------------------------------------------------
    // A resting limit order may never be reached. Without a timeout it sits there
    // forever, the bot holds a stale view of the market, and the position is
    // neither entered nor abandoned.
    //
    // 5 minutes is freqtrade's own default, kept because at a 1h timeframe a
    // candle lasts an hour and a fill that has not happened in five minutes is
    // unlikely to happen at that price. On timeout freqtrade cancels and
    // re-evaluates on the next candle, which is the behaviour we want.
    //
    // The cost of this choice is real and worth naming: a cancelled entry is a
    // missed trade, so a maker-only bot trades less often than a taker one. That
    // is the trade being made deliberately - fewer trades at half the fee, rather
    // than more trades at double it.
    "unfilledtimeout": {
        "entry": 5,
        "exit": 5,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },

    // -------------------------------------------------------------------------
    // ORDER TIME IN FORCE - this is what GUARANTEES the maker rate
    // -------------------------------------------------------------------------
    // "PO" is Post Only. Kraken rejects the order outright if it would cross the
    // spread, so the order can never be charged the taker rate. You either get
    // the maker rate or you get no fill - never 0.80%.
    //
    // WHY THIS IS NEEDED ON TOP OF order_types "limit":
    //
    // A limit order is not automatically a maker order. What decides it is
    // whether the order RESTS on the book or CROSSES the spread. With price_side
    // "same" it rests - but only at the price the bot read a moment ago. Between
    // reading the book and Kraken receiving the order, the market can move. A buy
    // limit priced at what WAS the bid can arrive above the new ask, cross, and
    // be filled as a taker at 0.80% instead of 0.40%.
    //
    // That is a silent doubling of the fee on exactly the trades where the market
    // moved against you - the worst possible moment for it. Post Only removes the
    // possibility: the exchange refuses the crossing order rather than filling it
    // at the wrong rate.
    //
    // Verified supported. freqtrade/exchange/kraken.py declares
    //     "order_time_in_force": ["GTC", "IOC", "PO"]
    // and maps it to ccxt's postOnly flag:
    //     if time_in_force == "PO":
    //         params.pop("timeInForce", None)
    //         params["postOnly"] = True
    //
    // THE COST, stated plainly: post-only orders are rejected when they would
    // cross, so some entries never happen. This bot will trade LESS often than one
    // using market orders. That is the deliberate trade - fewer trades at half the
    // fee, rather than more trades at double it.
    //
    // Rejections are not fatal. ccxt raises InvalidOrder, freqtrade wraps it in
    // InvalidOrderException, and the entry loop catches it:
    //     except DependencyException as exception:
    //         logger.warning("Unable to create trade for %s: %s", ...)
    // because InvalidOrderException inherits ExchangeError -> DependencyException.
    // The trade is skipped, a warning is logged, and the bot carries on.
    //
    // Exits are post-only too, so the same reasoning applies on the way out.
    // stoploss and emergency_exit stay MARKET orders - see order_types above. A
    // stoploss must actually fill, and a rejected stoploss would leave the
    // position open through the very loss it was meant to prevent.
    "order_time_in_force": {
        "entry": "PO",
        "exit": "PO"
    },

    // -------------------------------------------------------------------------
    // TIMEFRAME
    // -------------------------------------------------------------------------
    // 1h, not 5m. See the fee block above and the strategy's `timeframe` for the
    // arithmetic: Kraken Tier 1 charges 1.60% round trip, the mean BTC/CAD 5m
    // candle moves 0.075%, and the mean 1h candle moves 0.650%. On 5m the price
    // must move about 21 candles' worth to cover the fee; on 1h, about 2.5.
    //
    // This must match the strategy's own `timeframe`. Freqtrade uses the
    // strategy's value, so a mismatch here would be silently ignored rather than
    // erroring - which is why both are set and a test checks they agree.
    "timeframe": "1h",
    "process_only_new_candles": true,

    // -------------------------------------------------------------------------
    // DATA STORAGE
    // -------------------------------------------------------------------------
    "dataformat_ohlcv": "json",
    "dataformat_trades": "jsongz",

    // -------------------------------------------------------------------------
    // PROTECTIONS
    // -------------------------------------------------------------------------
    // NOT configured here. Freqtrade 2026.8 rejects a `protections` key in the
    // configuration file:
    //
    //   Configuration error: DEPRECATED: Setting 'protections' in the
    //   configuration is deprecated.
    //
    // They are defined as a @property on the strategy instead - see
    // config/strategies/moderate_multi.py. MaxDrawdown, StoplossGuard and
    // CooldownPeriod are all configured there.

    // -------------------------------------------------------------------------
    // EDGE
    // -------------------------------------------------------------------------
    // NOT configured here. Freqtrade removed Edge entirely in 2025.6, and any
    // non-empty edge block is now a hard startup error:
    //
    //   Configuration error: Edge is no longer supported and has been removed
    //   from Freqtrade with 2025.6.
    //
    // (see config_validation.py). Position sizing is handled by stake_amount
    // and tradable_balance_ratio instead.

    // -------------------------------------------------------------------------
    // TELEGRAM
    // -------------------------------------------------------------------------
    // Deliberately absent. This bot notifies through Discord, and a `telegram`
    // block is not safe to include just to say it is off: the schema requires
    // token AND chat_id whenever the block exists, so
    //
    //     "telegram": {"enabled": false}
    //
    // fails config validation with "missing required property 'token'" and stops
    // the bot from starting. To enable Telegram, add all three of enabled,
    // token and chat_id.

    // -------------------------------------------------------------------------
    // DISCORD
    // webhook_url is injected from the Swarm secret by the entrypoint.
    //
    // Every key here maps to an RPCMessageType, and freqtrade reads it as a LIST
    // OF FIELD TEMPLATES, not a boolean:
    //
    //     if fields := self._config["discord"].get(msg["type"].value):
    //         for f in fields:
    //             for k, v in f.items():
    //                 v.format(**msg)
    //
    // So "entry_fill": true is wrong twice over. The schema declares these as
    // arrays, so a boolean fails config validation outright; and if it somehow
    // got through, `for f in True` would raise TypeError when a message fired.
    //
    // A message type must be omitted entirely to disable it: any truthy value is
    // iterated. The {braces} are substituted from the message payload, so every
    // placeholder below is a key that the corresponding message really carries.
    // -------------------------------------------------------------------------
    "discord": {
        "enabled": true,

        // Trade opened / closed: full detail, matching freqtrade's schema defaults.
        "entry_fill": [
            {"Trade ID": "{trade_id}"},
            {"Exchange": "{exchange}"},
            {"Pair": "{pair}"},
            {"Direction": "{direction}"},
            {"Open rate": "{open_rate}"},
            {"Amount": "{amount}"},
            {"Open date": "{open_date:%Y-%m-%d %H:%M:%S}"},
            {"Enter tag": "{enter_tag}"},
            {"Strategy": "{strategy} {timeframe}"}
        ],
        "exit_fill": [
            {"Trade ID": "{trade_id}"},
            {"Exchange": "{exchange}"},
            {"Pair": "{pair}"},
            {"Direction": "{direction}"},
            {"Open rate": "{open_rate}"},
            {"Close rate": "{close_rate}"},
            {"Amount": "{amount}"},
            {"Open date": "{open_date:%Y-%m-%d %H:%M:%S}"},
            {"Close date": "{close_date:%Y-%m-%d %H:%M:%S}"},
            {"Profit": "{profit_amount} {stake_currency}"},
            {"Profitability": "{profit_ratio:.2%}"},
            {"Enter tag": "{enter_tag}"},
            {"Exit Reason": "{exit_reason}"},
            {"Strategy": "{strategy}"},
            {"Timeframe": "{timeframe}"}
        ],

        // An order that timed out and was cancelled. These payloads carry pair,
        // limit and stake amount but none of the fill fields.
        "entry_cancel": [
            {"Pair": "{pair}"},
            {"Limit": "{limit}"},
            {"Amount": "{stake_amount} {stake_currency}"}
        ],
        "exit_cancel": [
            {"Pair": "{pair}"},
            {"Limit": "{limit}"}
        ],

        // status, warning and startup each carry a single "status" string.
        "status": [{"Status": "{status}"}],
        "warning": [{"Warning": "{status}"}],
        "startup": [{"Status": "{status}"}],

        // Circuit breakers. The payload is a PairLock, which provides pair,
        // reason and lock_end_time.
        "protection_trigger": [
            {"Pair": "{pair}"},
            {"Reason": "{reason}"},
            {"Unlocks": "{lock_end_time}"}
        ],
        "protection_trigger_global": [
            {"Reason": "{reason}"},
            {"Unlocks": "{lock_end_time}"}
        ]
    },

    // -------------------------------------------------------------------------
    // API SERVER (REST API used by the AI Orchestrator + serves FreqUI)
    // username/password/jwt_secret_key/ws_token are injected by the entrypoint.
    // -------------------------------------------------------------------------
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "info",
        "enable_openapi": true,
        "CORS_origins": [
            "http://localhost:8082",
            "http://127.0.0.1:8082"
        ]
    },

    // -------------------------------------------------------------------------
    // WEBSERVER (FreqUI)
    // -------------------------------------------------------------------------
    "webserver": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8081,
        "verbosity": "info"
    },

    // -------------------------------------------------------------------------
    // DATABASE AND DRY-RUN - DELIBERATELY NOT SET HERE
    // -------------------------------------------------------------------------
    // NOTE: `db_url` and `dry_run` deliberately do NOT live here. They are in
    // config/canada_kraken.json, which is merged last and therefore wins, so
    // that the two settings that must change together sit side by side in one
    // file. Setting them here would be dead config: silently overridden, and a
    // trap for anyone who edited this file expecting it to take effect.
    //
    // -------------------------------------------------------------------------
    // LOGGING
    // -------------------------------------------------------------------------
    "logging": {
        "logfile": "/freqtrade/user_data/logs/freqtrade.log",
        "loglevel": "INFO",
        "logfile_level": "DEBUG",
        "syslog": false,
        "logrotate": true,
        "logrotate_max_bytes": 10485760,
        "logrotate_backup_count": 10
    },

    // -------------------------------------------------------------------------
    // STRATEGY
    // The strategy file is staged into the strategies volume by the entrypoint
    // from a read-only Swarm config.
    //
    // This value MUST stay here, in the config, and MUST NOT be passed as a
    // --strategy command-line argument.
    //
    // Freqtrade resolves the strategy like this (configuration.py,
    // _process_common_options):
    //
    //     if self.args.get("strategy") or not config.get("strategy"):
    //         config.update({"strategy": self.args.get("strategy")})
    //
    // so a --strategy flag on the command line overrides EVERY config file, on
    // every start and every reload. It was passed there originally, which meant
    // the operator could change the strategy in the UI, watch it save, and have
    // nothing happen - because the command line quietly won. Removing the flag is
    // what makes the setting mean anything.
    //
    // The default is here rather than only in runtime_settings.json so that a bot
    // with no operator settings still starts. Freqtrade refuses to start without
    // a strategy.
    // -------------------------------------------------------------------------
    "strategy": "ModerateMultiPairStrategy",

    // Shared with the AI orchestrator (mounted as /app/strategies) so generated
    // strategies can be backtested before the operator is asked to approve them.
    "strategy_path": "/freqtrade/user_data/strategies",

    // -------------------------------------------------------------------------
    // PLOTTING
    // -------------------------------------------------------------------------
    "plot": {
        "main_plot": {
            "ema_9": {"color": "blue"},
            "ema_21": {"color": "orange"},
            "ema_50": {"color": "green"},
            "ema_200": {"color": "red"},
            "bb_lowerband": {"color": "gray"},
            "bb_middleband": {"color": "gray"},
            "bb_upperband": {"color": "gray"}
        },
        "subplots": {
            "rsi": {
                "rsi": {"color": "purple"},
                "rsi_overbought": {"color": "red"},
                "rsi_oversold": {"color": "green"}
            },
            "macd": {
                "macd": {"color": "blue"},
                "macdsignal": {"color": "orange"},
                "macdhist": {"color": "green"}
            }
        }
    },

    // -------------------------------------------------------------------------
    // OPERATIONAL
    // -------------------------------------------------------------------------
    "cancel_open_orders_on_exit": true,

    "internals": {
        "process_throttle_secs": 5
    }
}
