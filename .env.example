# Environment Variables Template
# Copy to .env and fill in values (but prefer Docker secrets for sensitive data)

# Timezone
TZ=America/Toronto

# Freqtrade API (set via Docker secrets in production)
# FREQTRADE_API_PASSWORD=your_secure_password
# FREQTRADE_ENCRYPT_KEY=your_encryption_key

# OpenRouter (set via Docker secrets)
# OPENROUTER_API_KEY=sk-or-v1-...

# Kraken API (set via Docker secrets)
# KRAKEN_API_KEY=your_kraken_api_key
# KRAKEN_API_SECRET=your_kraken_api_secret

# Discord Webhook (optional, set via Docker secrets)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Nextcloud (optional, set via Docker secrets)
# NEXTCLOUD_URL=https://your-nextcloud.com/remote.php/dav/files/username/backups
# NEXTCLOUD_USER=your_username
# NEXTCLOUD_PASS=your_app_password

# Backup encryption (set via Docker secrets)
# BACKUP_ENCRYPT_KEY=age_public_key